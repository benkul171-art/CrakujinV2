-- CRACKUJIN - WORKING KEY SYSTEM (CoreGui)
-- Key: CRACKUJIN.KEYLOGIN
loadstring([[
local player = game.Players.LocalPlayer
local CORRECT_KEY = "CRACKUJIN.KEYLOGIN"

-- Create GUI
local gui = Instance.new("ScreenGui")
gui.Name = "Crackujin"
gui.Parent = game:GetService("CoreGui")

local window = Instance.new("Frame")
window.Size = UDim2.new(0, 350, 0, 260)
window.Position = UDim2.new(0.5, -175, 0.5, -130)
window.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
window.BackgroundTransparency = 0
window.BorderSizePixel = 0
window.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 12)
corner.Parent = window

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 80, 200)
stroke.Thickness = 2
stroke.Parent = window

-- Title Bar
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 45)
titleBar.BackgroundColor3 = Color3.fromRGB(255, 80, 200)
titleBar.BackgroundTransparency = 0.2
titleBar.Parent = window

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -50, 1, 0)
title.Position = UDim2.new(0, 15, 0, 0)
title.BackgroundTransparency = 1
title.Text = "CRACKUJIN"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.TextSize = 20
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = titleBar

local close = Instance.new("TextButton")
close.Size = UDim2.new(0, 30, 0, 30)
close.Position = UDim2.new(1, -38, 0, 8)
close.BackgroundColor3 = Color3.fromRGB(255, 50, 100)
close.Text = "X"
close.TextColor3 = Color3.fromRGB(255, 255, 255)
close.TextSize = 14
close.Font = Enum.Font.GothamBold
close.Parent = titleBar
close.MouseButton1Click:Connect(function() gui:Destroy() end)

local keyDisplay = Instance.new("TextLabel")
keyDisplay.Size = UDim2.new(0.9, 0, 0, 35)
keyDisplay.Position = UDim2.new(0.05, 0, 0, 60)
keyDisplay.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
keyDisplay.Text = "KEY: " .. CORRECT_KEY
keyDisplay.TextColor3 = Color3.fromRGB(255, 100, 200)
keyDisplay.TextSize = 12
keyDisplay.Font = Enum.Font.GothamBold
keyDisplay.Parent = window

local instruction = Instance.new("TextLabel")
instruction.Size = UDim2.new(1, -20, 0, 25)
instruction.Position = UDim2.new(0, 10, 0, 105)
instruction.BackgroundTransparency = 1
instruction.Text = "Enter the key below to activate"
instruction.TextColor3 = Color3.fromRGB(180, 180, 180)
instruction.TextSize = 11
instruction.Font = Enum.Font.Gotham
instruction.Parent = window

local keyBox = Instance.new("TextBox")
keyBox.Size = UDim2.new(0.8, 0, 0, 40)
keyBox.Position = UDim2.new(0.1, 0, 0, 135)
keyBox.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
keyBox.Text = ""
keyBox.PlaceholderText = "Enter key here"
keyBox.TextColor3 = Color3.fromRGB(255, 255, 255)
keyBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 160)
keyBox.TextSize = 13
keyBox.Font = Enum.Font.Gotham
keyBox.Parent = window

local copyBtn = Instance.new("TextButton")
copyBtn.Size = UDim2.new(0.3, 0, 0, 32)
copyBtn.Position = UDim2.new(0.35, 0, 0, 185)
copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 120)
copyBtn.Text = "COPY KEY"
copyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
copyBtn.TextSize = 11
copyBtn.Font = Enum.Font.GothamBold
copyBtn.Parent = window

copyBtn.MouseButton1Click:Connect(function()
    setclipboard(CORRECT_KEY)
    copyBtn.Text = "COPIED!"
    task.wait(1)
    copyBtn.Text = "COPY KEY"
end)

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 0, 25)
statusLabel.Position = UDim2.new(0, 10, 0, 225)
statusLabel.BackgroundTransparency = 1
statusLabel.Text = "Waiting for key..."
statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
statusLabel.TextSize = 11
statusLabel.Font = Enum.Font.Gotham
statusLabel.Parent = window

local activateBtn = Instance.new("TextButton")
activateBtn.Size = UDim2.new(0.5, 0, 0, 40)
activateBtn.Position = UDim2.new(0.25, 0, 0, 255)
activateBtn.BackgroundColor3 = Color3.fromRGB(255, 80, 200)
activateBtn.BackgroundTransparency = 0.2
activateBtn.Text = "ACTIVATE"
activateBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
activateBtn.TextSize = 14
activateBtn.Font = Enum.Font.GothamBold
activateBtn.Parent = window

activateBtn.MouseButton1Click:Connect(function()
    if keyBox.Text == CORRECT_KEY then
        statusLabel.Text = "✓ KEY VALID! Loading..."
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        activateBtn.Visible = false
        copyBtn.Visible = false
        
        -- Load your main script here
        pcall(function()
            -- Replace this URL with your actual main script
            -- loadstring(game:HttpGet("YOUR_MAIN_SCRIPT_URL"))()
            statusLabel.Text = "✓ Main script loaded!"
        end)
        
        task.wait(1)
        gui:Destroy()
    else
        statusLabel.Text = "✗ INVALID KEY!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        keyBox.Text = ""
    end
end)

-- Draggable
local dragging = false
local dragStart, startPos
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = window.Position
    end
end)
titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        window.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

print("Crackujin Key System Ready - Key: " .. CORRECT_KEY)
]])()
